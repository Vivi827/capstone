# Server-only (Railway / backend local). NEVER ship to frontend bundle. NEVER commit real values.
# Phase 1C (백은혜) populates real values. See docs/shared/SETUP.md §5.

# Gemini 2.5 Flash — Google AI Studio (generativelanguage.googleapis.com)
GOOGLE_AI_API_KEY=

# Google Cloud STT + TTS — Google Cloud Console API key
# Required APIs: Cloud Speech-to-Text, Cloud Text-to-Speech
GOOGLE_CLOUD_API_KEY=

# Supabase (Phase 1C — sessions/messages 테이블, RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional 5-axis analyzer experiment. Keep the production default (`rule`)
# until the real-speech draft labels have an independent human-review pass.
# PALLY_AXIS_ANALYZER=hybrid
# PALLY_AXIS_DATASET=data/fixtures/axis_dataset_combined_real_speech_provisional.jsonl

# KakaoPay sandbox recurring subscriptions (TCSUBSCRIP is fixed in server code).
# Never use production credentials. Keep the worker enabled while accepting checkouts.
BILLING_PROVIDER=mock
KAKAOPAY_SECRET_KEY_DEV=
BILLING_WORKER_ENABLED=false
BILLING_CALLBACK_ORIGIN=http://localhost:8001
BILLING_FRONTEND_ORIGINS=http://localhost:3000,https://yourpally.app
